# 首次安装向导会填写模型目录，无需手动激活 Python 环境。
LOCAL_AGENT_MODEL="models/Qwen3-14B-AWQ"
LOCAL_AGENT_BASE_URL="http://127.0.0.1:8000/v1"
LOCAL_AGENT_API_KEY="local"
LOCAL_AGENT_TEMPERATURE=0.2
LOCAL_AGENT_MAX_TOKENS=2048
LOCAL_AGENT_EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"
LOCAL_AGENT_KNOWLEDGE_DIR="data/knowledge"
LOCAL_AGENT_INDEX_DIR="data/indexes"
LOCAL_AGENT_CHECKPOINT_DB="data/checkpoints/langgraph.sqlite"
LOCAL_AGENT_MODEL_STARTUP_TIMEOUT=1200

# 已在 NVIDIA A30 24 GB 上验证的 Qwen3-14B-AWQ 参数。
VLLM_WORKER_MULTIPROC_METHOD="spawn"
VLLM_HOST="127.0.0.1"
VLLM_PORT=8000
VLLM_DTYPE="half"
VLLM_QUANTIZATION="awq"
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=4

# Brave 联网搜索默认关闭；启用时自行填写，不能提交到 Git。
# BRAVE_API_KEY=""
